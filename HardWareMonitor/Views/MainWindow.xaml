<Window x:Class="HardWareMonitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HardWareMonitor.ViewModels"
        Title="Hardware Monitor Pro" 
        Height="800" 
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Стиль для карточек с тенью -->
        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <!-- Стиль для кнопок навигации -->
        <Style TargetType="Button" x:Key="NavButtonStyle">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2196F3"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для заголовков информации -->
        <Style TargetType="TextBlock" x:Key="InfoLabelStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin" Value="0,5,10,5"/>
        </Style>

        <!-- Стиль для значений информации -->
        <Style TargetType="TextBlock" x:Key="InfoValueStyle">
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- Стиль для индикаторов прогресса -->
        <Style TargetType="Border" x:Key="ProgressBarStyle">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
    </Window.Resources>

    <!-- Основная сетка окна -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Панель навигации -->
            <RowDefinition Height="*"/>
            <!-- Основной контент -->
            <RowDefinition Height="Auto"/>
            <!-- Статус бар -->
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопка справки -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Background="#2196F3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Hardware Monitor Pro" 
                           FontSize="24" FontWeight="Bold" 
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <!-- Кнопка справки -->
                <Button Grid.Column="1" 
                        Content="?"
                        Width="40" Height="40"
                        FontSize="24" FontWeight="Bold"
                        Background="#1976D2"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding ShowHelpCommand}"
                        ToolTip="Показать справку"/>
            </Grid>
        </Border>

        <!-- Панель навигации и управления -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Background="White">
            <StackPanel>
                <!-- Кнопки устройств -->
                <WrapPanel Margin="0,0,0,10">
                    <Button Content="CPU" Style="{StaticResource NavButtonStyle}" 
                            Command="{Binding ShowCpuCommand}"/>
                    <Button Content="GPU" Style="{StaticResource NavButtonStyle}" 
                            Command="{Binding ShowGpuCommand}"/>
                    <Button Content="RAM" Style="{StaticResource NavButtonStyle}" 
                            Command="{Binding ShowMemoryCommand}"/>
                    <Button Content="СЕТЬ" Style="{StaticResource NavButtonStyle}" 
                            Command="{Binding ShowNetworkCommand}"/>
                    <Button Content="HDD (Физ.)" Style="{StaticResource NavButtonStyle}" 
                            Command="{Binding ShowDiskCommand}"/>
                    <!-- Кнопка диспетчера задач -->
                    <Button Content="ДИСПЕТЧЕР ЗАДАЧ" Style="{StaticResource NavButtonStyle}" 
                            Background="#E0E0E0" Foreground="Black"
                            Command="{Binding ShowTaskManagerCommand}"/>
                </WrapPanel>

                <!-- Панель управления обновлением -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Интервал обновления (сек):" 
                               VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="IntervalTextBox" Grid.Column="1" 
                             Text="{Binding UpdateInterval, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="5" Padding="5" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Применить" 
                            Command="{Binding ApplyIntervalCommand}"
                            Margin="5" Padding="15,5" Background="#4CAF50" 
                            Foreground="White" BorderThickness="0"/>
                    <Button x:Name="StopButton" Grid.Column="3" 
                            Content="{Binding UpdateButtonText}" 
                            Command="{Binding ToggleUpdateCommand}"
                            Margin="5" Padding="15,5" 
                            Background="{Binding UpdateButtonColor}" 
                            Foreground="White" BorderThickness="0"/>

                    <TextBlock x:Name="UpdateStatusText" Grid.Column="4" 
                               Text="{Binding UpdateStatusText}"
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               Margin="5" Foreground="Gray"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Основной контент -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel Margin="15">

                    <!-- Секция процессора -->
                    <StackPanel Visibility="{Binding IsCpuVisible}">
                        <TextBlock Text="ПРОЦЕССОР" FontSize="18" FontWeight="Bold" 
                                   Foreground="#2196F3" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Модель:" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CpuInfo.Name}" Style="{StaticResource InfoValueStyle}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Производитель:" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CpuInfo.Manufacturer}" Style="{StaticResource InfoValueStyle}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Архитектура:" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CpuInfo.Architecture}" Style="{StaticResource InfoValueStyle}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Ядра:" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CpuInfo.CoreCount}" Style="{StaticResource InfoValueStyle}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Потоки:" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CpuInfo.ThreadCount}" Style="{StaticResource InfoValueStyle}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Базовая частота:" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" 
                                       Text="{Binding CpuInfo.BaseFrequency, StringFormat='{}{0:F0} МГц'}" 
                                       Style="{StaticResource InfoValueStyle}"/>
                        </Grid>

                        <!-- Индикатор загрузки CPU -->
                        <TextBlock Text="Загрузка CPU:" Margin="0,15,0,5"/>
                        <Border Style="{StaticResource ProgressBarStyle}">
                            <Grid>
                                <Border HorizontalAlignment="Left" 
                                        Width="{Binding CpuInfo.LoadPercentage}" 
                                        Background="#2196F3" Height="20" CornerRadius="3"/>
                                <TextBlock Text="{Binding CpuInfo.LoadPercentage, StringFormat='{}{0:F1}%'}" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" 
                                           Foreground="White" FontWeight="Bold"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Секция видеокарты (без загрузки) -->
                    <StackPanel Visibility="{Binding IsGpuVisible}">
                        <TextBlock Text="ВИДЕОКАРТА" FontSize="18" FontWeight="Bold" 
                                   Foreground="#9C27B0" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Модель:" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GpuInfo.Name}" Style="{StaticResource InfoValueStyle}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Видеопамять:" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" 
                                       Text="{Binding GpuInfo.VideoMemory, StringFormat='{}{0:N0} байт'}" 
                                       Style="{StaticResource InfoValueStyle}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Секция оперативной памяти -->
                    <StackPanel Visibility="{Binding IsMemoryVisible}">
                        <TextBlock Text="ОПЕРАТИВНАЯ ПАМЯТЬ" FontSize="18" FontWeight="Bold" 
                                   Foreground="#4CAF50" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Всего:" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" 
                                       Text="{Binding MemoryInfo.TotalMemoryBytes, StringFormat='{}{0:N0} байт'}" 
                                       Style="{StaticResource InfoValueStyle}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Доступно:" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" 
                                       Text="{Binding MemoryInfo.AvailableMemoryBytes, StringFormat='{}{0:N0} байт'}" 
                                       Style="{StaticResource InfoValueStyle}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Модулей:" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MemoryInfo.Modules.Count}" Style="{StaticResource InfoValueStyle}"/>
                        </Grid>

                        <!-- Индикатор использования памяти -->
                        <TextBlock Text="Использование памяти:" Margin="0,15,0,5"/>
                        <Border Style="{StaticResource ProgressBarStyle}">
                            <Grid>
                                <Border HorizontalAlignment="Left" 
                                        Width="{Binding MemoryInfo.UsagePercentage}" 
                                        Background="#4CAF50" Height="20" CornerRadius="3"/>
                                <TextBlock Text="{Binding MemoryInfo.UsagePercentage, StringFormat='{}{0:F1}%'}" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" 
                                           Foreground="White" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <!-- Список модулей памяти -->
                        <TextBlock Text="Модули памяти:" FontWeight="Bold" Margin="0,15,0,5"/>
                        <ItemsControl ItemsSource="{Binding MemoryInfo.Modules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F5F5F5" Margin="0,2,0,2" Padding="8" CornerRadius="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Manufacturer}"/>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding Capacity, StringFormat='{}{0:N0} байт'}"/>
                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding Speed, StringFormat='{}{0} МГц'}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Секция дисков -->
                    <StackPanel Visibility="{Binding IsDiskVisible}">
                        <!-- Физические диски -->
                        <TextBlock Text="ФИЗИЧЕСКИЕ ДИСКИ" FontSize="18" FontWeight="Bold" 
                                   Foreground="#FF9800" Margin="0,0,0,15"/>

                        <ItemsControl ItemsSource="{Binding DiskInfo.PhysicalDisks}" Margin="0,0,0,15">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F5F5F5" Margin="0,2,0,2" Padding="8" CornerRadius="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="250"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Model}"/>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding Size, StringFormat='{}{0:N0} байт'}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding MediaType}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Логические диски -->
                        <TextBlock Text="ЛОГИЧЕСКИЕ ДИСКИ" FontSize="18" FontWeight="Bold" 
                                   Foreground="#FF9800" Margin="0,0,0,15"/>

                        <ItemsControl ItemsSource="{Binding DiskInfo.LogicalDisks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding DriveLetter}" 
                                                       FontWeight="Bold" FontSize="16"/>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding TotalSize, StringFormat='Общий: {0:N0} байт'}"/>
                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding FreeSpace, StringFormat='Свободно: {0:N0} байт'}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding FileSystem}"/>
                                        </Grid>

                                        <!-- Индикатор заполнения диска -->
                                        <TextBlock Text="Заполнение:" Margin="0,5,0,2"/>
                                        <Border Style="{StaticResource ProgressBarStyle}" Height="15">
                                            <Grid>
                                                <Border HorizontalAlignment="Left" 
                                                        Width="{Binding UsagePercentage}" 
                                                        Background="#FF9800" Height="15" CornerRadius="3"/>
                                                <TextBlock Text="{Binding UsagePercentage, StringFormat='{}{0:F1}%'}" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                           Foreground="White" FontSize="10" FontWeight="Bold"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Секция сети -->
                    <StackPanel Visibility="{Binding IsNetworkVisible}">
                        <TextBlock Text="СЕТЕВЫЕ АДАПТЕРЫ" FontSize="18" FontWeight="Bold" 
                                   Foreground="#E91E63" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Адаптер:" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding NetworkInfo.Name}" Style="{StaticResource InfoValueStyle}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="MAC-адрес:" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NetworkInfo.MacAddress}" Style="{StaticResource InfoValueStyle}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Скорость:" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" 
                                       Text="{Binding NetworkInfo.Speed, StringFormat='{}{0:N0} бит/с'}" 
                                       Style="{StaticResource InfoValueStyle}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Секция диспетчера задач -->
                    <StackPanel Visibility="{Binding IsTaskManagerVisible}">
                        <TextBlock Text="ДИСПЕТЧЕР ЗАДАЧ" FontSize="18" FontWeight="Bold" 
                                   Foreground="#FF5722" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="300"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Панель управления -->
                            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Поиск:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1" 
                                             Text="{Binding TaskManagerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="5" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding FilteredProcessesCount, StringFormat='Показано процессов: {0}'}" 
                                               VerticalAlignment="Center" Margin="10,0,10,0"
                                               Foreground="#666666"/>

                                    <Button Grid.Column="3" Content="Обновить" 
                                            Command="{Binding RefreshTaskManagerCommand}"
                                            Background="#4CAF50" Foreground="White" 
                                            BorderThickness="0" Padding="15,5" Margin="5,0"/>
                                </Grid>
                            </Border>

                            <!-- Список процессов -->
                            <ListView Grid.Row="1" 
                                      ItemsSource="{Binding FilteredProcesses}" 
                                      Height="300"
                                      ScrollViewer.VerticalScrollBarVisibility="Visible">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="PID" Width="80" DisplayMemberBinding="{Binding Id}"/>
                                        <GridViewColumn Header="Имя процесса" Width="250" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="Память (байт)" Width="150">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding WorkingSet, StringFormat='{}{0:N0}'}" 
                                                               HorizontalAlignment="Right"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Память (МБ)" Width="120">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding WorkingSet, StringFormat='{}{0:N2} МБ'}" 
                                                               HorizontalAlignment="Right"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <!-- Статистика -->
                            <Border Grid.Row="2" Background="#F5F5F5" CornerRadius="5" Padding="10" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding TotalProcessesCount, StringFormat='Всего процессов: {0}'}" 
                                               Foreground="#666666"
                                               Margin="5,0"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding TotalMemoryUsage, StringFormat='Общая память: {0:N0} байт'}" 
                                               Foreground="#666666"
                                               Margin="5,0"/>
                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding TotalMemoryUsageMb, StringFormat='Общая память: {0:F2} МБ'}" 
                                               Foreground="#666666"
                                               Margin="5,0"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Системная информация (всегда видна) -->
                    <StackPanel Margin="0,20,0,0" Visibility="{Binding IsSystemInfoVisible}">
                        <TextBlock Text="СИСТЕМНАЯ ИНФОРМАЦИЯ" FontSize="18" FontWeight="Bold" 
                                   Foreground="#666666" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Компьютер:" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SystemInfo.MachineName}" Style="{StaticResource InfoValueStyle}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Операционная система:" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SystemInfo.OSName}" Style="{StaticResource InfoValueStyle}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Версия:" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SystemInfo.OSVersion}" Style="{StaticResource InfoValueStyle}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Статус бар -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Background="#E0E0E0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Кнопки экспорта и обновления -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="Экспорт TXT" Command="{Binding ExportTxtCommand}" 
                            Margin="5" Padding="15,5"/>
                    <Button Content="Экспорт CSV" Command="{Binding ExportCsvCommand}" 
                            Margin="5" Padding="15,5" Background="#E0E0E0" Foreground="Black"/>
                    <Button Content="Экспорт JSON" Command="{Binding ExportJsonCommand}" 
                            Margin="5" Padding="15,5"/>
                    <Button Content="Обновить" Command="{Binding RefreshCommand}" 
                            Margin="5" Padding="15,5"/>
                </StackPanel>

                <!-- Строка статуса -->
                <Border Grid.Column="1" Background="#F5F5F5" CornerRadius="5" Padding="8">
                    <TextBlock Text="{Binding StatusMessage}" 
                             TextWrapping="Wrap"
                             VerticalAlignment="Center"
                             Foreground="Gray"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>